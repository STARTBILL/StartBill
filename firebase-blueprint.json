{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account profile and role",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "fullName": { "type": "string" },
        "companyName": { "type": "string" },
        "plan": { "type": "string" },
        "region": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "User billing subscription plan details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "plan": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "interval": { "type": "string" },
        "status": { "type": "string" },
        "startDate": { "type": "string" },
        "nextBillingDate": { "type": "string" }
      },
      "required": ["id", "userId", "plan", "status"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "An invoice generated for a client",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientName": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" },
        "subtotal": { "type": "number" },
        "tps": { "type": "number" },
        "tvq": { "type": "number" },
        "total": { "type": "number" },
        "taxAmount": { "type": "number" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "amountPaid": { "type": "number" },
        "remainingBalance": { "type": "number" },
        "paymentStatus": { "type": "string" }
      },
      "required": ["id", "clientName", "date", "status", "total"]
    },
    "Client": {
      "title": "Client",
      "description": "A client of the user or business",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessRef": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "province": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "lastInvoiceDate": { "type": ["string", "null"] },
        "totalBilled": { "type": "number" },
        "totalPaid": { "type": "number" },
        "amountDue": { "type": "number" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "status"]
    },
    "Expense": {
      "title": "Expense",
      "description": "A business expense incurred by the business or user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessRef": { "type": "string" },
        "categoryRef": { "type": "string" },
        "supplierRef": { "type": "string" },
        "amount": { "type": "number" },
        "taxAmount": { "type": "number" },
        "currency": { "type": "string", "enum": ["CAD", "FCFA", "HTG", "USD"] },
        "expenseDate": { "type": "string" },
        "paymentStatus": { "type": "string", "enum": ["paid", "pending", "unpaid"] },
        "eligibleAmount": { "type": "number" },
        "createdAt": { "type": "string" },
        "category": { "type": "string" },
        "provider": { "type": "string" },
        "date": { "type": "string" },
        "total": { "type": "number" },
        "isEligible": { "type": "boolean" },
        "userId": { "type": "string" }
      },
      "required": ["amount", "currency", "expenseDate", "paymentStatus", "eligibleAmount"]
    },
    "FinancialObligation": {
      "title": "FinancialObligation",
      "description": "Debts, bank loans, credit cards, tax and supplier liabilities for balance sheet tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessRef": { "type": "string" },
        "type": { "type": "string", "enum": ["loan", "credit_card", "tax_payable", "supplier_payable", "other"] },
        "description": { "type": "string" },
        "currentBalance": { "type": "number" },
        "monthlyPayment": { "type": "number" },
        "dueDate": { "type": "string" },
        "isShortTerm": { "type": "boolean" },
        "currency": { "type": "string", "enum": ["CAD", "FCFA", "HTG", "USD"] },
        "status": { "type": "string", "enum": ["active", "paid", "overdue"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["businessRef", "type", "description", "currentBalance", "dueDate", "isShortTerm", "currency", "status"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment transactions recorded in the platform (full & partial)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessRef": { "type": "string" },
        "invoiceRef": { "type": "string" },
        "clientRef": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["CAD", "FCFA", "HTG", "USD"] },
        "paymentMethod": { "type": "string", "enum": ["manual", "moncash", "orange_money", "wave", "mtn_money"] },
        "paymentDate": { "type": "string" },
        "isPartial": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "status": { "type": "string" },
        "transactionRef": { "type": "string" }
      },
      "required": ["amount", "currency", "paymentMethod", "paymentDate", "isPartial"]
    },
    "LearningArticle": {
      "title": "LearningArticle",
      "description": "Knowledge base article for the learning center",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "readTime": { "type": "string" },
        "published": { "type": "boolean" },
        "targetRegion": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "category", "content"]
    },
    "Alert": {
      "title": "Alert",
      "description": "System or user notifications and alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "severity": { "type": "string" },
        "isRead": { "type": "boolean" },
        "isGlobal": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "message", "severity"]
    },
    "FinancialHealthSnapshot": {
      "title": "FinancialHealthSnapshot",
      "description": "Calculated financial health snapshots over time for trend analysis",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessRef": { "type": "string" },
        "calculatedAt": { "type": "string" },
        "period": { "type": "string" },
        "availableCash": { "type": "number" },
        "currentAssets": { "type": "number" },
        "currentLiabilities": { "type": "number" },
        "totalOutstandingDebt": { "type": "number" },
        "monthlyRevenue": { "type": "number" },
        "monthlyExpenses": { "type": "number" },
        "netProfit": { "type": "number" },
        "healthScore": { "type": "number" },
        "workingCapital": { "type": "number" },
        "currentRatio": { "type": "number" },
        "quickRatio": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["businessRef", "calculatedAt", "healthScore"]
    },
    "FinancialAlert": {
      "title": "FinancialAlert",
      "description": "Financial alerts and notifications for liquidity, debts, and tax deadlines",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessRef": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "warning", "critical", "urgent"] },
        "isRead": { "type": "boolean" },
        "category": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["businessRef", "severity", "createdAt", "message"]
    },
    "RegionalSettings": {
      "title": "RegionalSettings",
      "description": "Configuration for supported operating regions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "currency": { "type": "string" },
        "currencySymbol": { "type": "string" },
        "defaultGst": { "type": "number" },
        "defaultPst": { "type": "number" },
        "defaultQst": { "type": "number" }
      },
      "required": ["id", "name", "currency"]
    },
    "Business": {
      "title": "Business",
      "description": "Business profile and core balance sheet metrics for financial health",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerRef": { "type": "string" },
        "businessName": { "type": "string" },
        "countryCode": { "type": "string", "enum": ["CA", "FR", "HT"] },
        "region": { "type": "string", "enum": ["canada", "afrique", "haiti"] },
        "currency": { "type": "string", "enum": ["CAD", "FCFA", "HTG", "USD"] },
        "accountingMethod": { "type": "string", "enum": ["cash", "accrual"] },
        "availableCash": { "type": "number" },
        "currentAssets": { "type": "number" },
        "currentLiabilities": { "type": "number" },
        "totalOutstandingDebt": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["ownerRef", "businessName", "countryCode", "region", "currency"]
    }
  },
  "firestore": {
    "/businesses/{businessId}": {
      "schema": "Business",
      "description": "Businesses collection with balance sheet metrics"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Users collection"
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "Subscription",
      "description": "Subscriptions collection"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Invoices collection"
    },
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Clients collection"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Expenses collection"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payments collection"
    },
    "/financial_obligations/{obligationId}": {
      "schema": "FinancialObligation",
      "description": "Financial obligations and debts collection"
    },
    "/financial_health_snapshots/{snapshotId}": {
      "schema": "FinancialHealthSnapshot",
      "description": "Financial health snapshots collection"
    },
    "/financial_alerts/{alertId}": {
      "schema": "FinancialAlert",
      "description": "Financial alerts and notifications collection"
    },
    "/learning_articles/{articleId}": {
      "schema": "LearningArticle",
      "description": "Learning center articles"
    },
    "/alerts/{alertId}": {
      "schema": "Alert",
      "description": "Alerts collection"
    },
    "/regionalSettings/{regionId}": {
      "schema": "RegionalSettings",
      "description": "Regional settings configuration"
    }
  }
}
