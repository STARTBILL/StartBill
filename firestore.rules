rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSignedIn() {
      return isAuthenticated();
    }

    function isSuperAdmin() {
      return isAuthenticated() && 
        request.auth.token.email != null && 
        (
          request.auth.token.email.lower() == 'contact.startbill@gmail.com' ||
          request.auth.token.email.lower() == 'admin.canada@startbill.com'
        );
    }

    function isAdmin() {
      return isAuthenticated() && 
        (
          isSuperAdmin() ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    function isOwner(businessRef) {
      return isAuthenticated() && 
             businessRef != null &&
             exists(/databases/$(database)/documents/businesses/$(businessRef)) &&
             get(/databases/$(database)/documents/businesses/$(businessRef)).data.ownerRef == request.auth.uid;
    }

    function isUserSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // RÈGLE D'OR : CLOISONNEMENT STRICT DES DONNÉES PAR RÉGION
    // Récupère la région d'inscription immuable de l'utilisateur connecté
    function userRegisteredRegion() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             'region' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data ?
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.region : null;
    }

    // Valide que la ressource ciblée correspond à la région de l'utilisateur
    function matchesUserRegion(docRegion) {
      return isAuthenticated() && (
        docRegion == null ||
        userRegisteredRegion() == null ||
        docRegion == userRegisteredRegion()
      );
    }

    // User collection:
    // - Inscription et profil utilisateur
    // - Mise à jour : conservation de la région assignée
    match /users/{userId} {
      allow read: if isAdmin() || isUserSelf(userId);
      allow create: if isUserSelf(userId);
      allow update: if isAdmin() || (
        isUserSelf(userId) && 
        (!('region' in request.resource.data) || !('region' in resource.data) || request.resource.data.region == resource.data.region)
      );
      allow delete: if isAdmin() || isUserSelf(userId);
    }

    // Businesses collection: STRICT DATA ISOLATION
    match /businesses/{businessId} {
      allow read: if isAdmin() || (
        isAuthenticated() && 
        resource.data.ownerRef == request.auth.uid
      );
      allow create: if isAdmin() || (
        isAuthenticated() && 
        request.resource.data.ownerRef == request.auth.uid
      );
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.ownerRef == request.auth.uid &&
        (!('region' in request.resource.data) || request.resource.data.region == resource.data.region)
      );
      allow delete: if isAdmin() || (
        isAuthenticated() && 
        resource.data.ownerRef == request.auth.uid
      );

      // Financial snapshots subcollection (for monthly historical health trends)
      match /financialSnapshots/{snapshotId} {
        allow read, write: if isAdmin() || (
          isAuthenticated() && 
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerRef == request.auth.uid
        );
      }
    }

    // Invoices collection: STRICT DATA ISOLATION & PERMANENT USER DELETION
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (
        isAuthenticated() && 
        (resource.data.userId == request.auth.uid || (resource.data.businessRef != null && isOwner(resource.data.businessRef))) &&
        matchesUserRegion(resource.data.region)
      );
      allow create: if isAdmin() || (
        isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        matchesUserRegion(request.resource.data.region)
      );
      allow update: if isAdmin() || (
        isAuthenticated() && 
        (resource.data.userId == request.auth.uid || (resource.data.businessRef != null && isOwner(resource.data.businessRef))) &&
        matchesUserRegion(resource.data.region) &&
        (!('region' in request.resource.data) || request.resource.data.region == resource.data.region)
      );
      allow delete: if isAdmin() || (
        isAuthenticated() && 
        (resource.data.userId == request.auth.uid || resource.data.ownerRef == request.auth.uid || (resource.data.businessRef != null && isOwner(resource.data.businessRef)))
      );
    }

    // Expenses collection: STRICT DATA ISOLATION & PERMANENT USER DELETION
    match /expenses/{expenseId} {
      allow read: if isAdmin() || (
        isAuthenticated() && 
        (resource.data.userId == request.auth.uid || resource.data.ownerRef == request.auth.uid || (resource.data.businessRef != null && isOwner(resource.data.businessRef))) &&
        matchesUserRegion(resource.data.region)
      );
      allow create: if isAdmin() || (
        isAuthenticated() && 
        (request.resource.data.userId == request.auth.uid || request.resource.data.ownerRef == request.auth.uid) &&
        matchesUserRegion(request.resource.data.region)
      );
      allow update: if isAdmin() || (
        isAuthenticated() && 
        (resource.data.userId == request.auth.uid || resource.data.ownerRef == request.auth.uid) &&
        matchesUserRegion(resource.data.region) &&
        (!('region' in request.resource.data) || request.resource.data.region == resource.data.region)
      );
      allow delete: if isAdmin() || (
        isAuthenticated() && 
        (resource.data.userId == request.auth.uid || resource.data.ownerRef == request.auth.uid || (resource.data.businessRef != null && isOwner(resource.data.businessRef)))
      );
    }

    // Clients collection: STRICT DATA ISOLATION & PERMANENT USER DELETION
    match /clients/{clientId} {
      allow read: if isAdmin() || (
        isAuthenticated() && 
        (resource.data.userId == request.auth.uid || resource.data.ownerRef == request.auth.uid || (resource.data.businessRef != null && isOwner(resource.data.businessRef))) &&
        matchesUserRegion(resource.data.region)
      );
      allow create: if isAdmin() || (
        isAuthenticated() && 
        (request.resource.data.userId == request.auth.uid || request.resource.data.ownerRef == request.auth.uid) &&
        matchesUserRegion(request.resource.data.region)
      );
      allow update: if isAdmin() || (
        isAuthenticated() && 
        (resource.data.userId == request.auth.uid || resource.data.ownerRef == request.auth.uid) &&
        matchesUserRegion(resource.data.region) &&
        (!('region' in request.resource.data) || request.resource.data.region == resource.data.region)
      );
      allow delete: if isAdmin() || (
        isAuthenticated() && 
        (resource.data.userId == request.auth.uid || resource.data.ownerRef == request.auth.uid || (resource.data.businessRef != null && isOwner(resource.data.businessRef)))
      );
    }

    // Payments collection: STRICT DATA ISOLATION & PERMANENT USER DELETION
    match /payments/{paymentId} {
      allow read: if isAdmin() || (
        isAuthenticated() && 
        (resource.data.userId == request.auth.uid || resource.data.ownerRef == request.auth.uid) &&
        matchesUserRegion(resource.data.region)
      );
      allow create: if isAdmin() || (
        isAuthenticated() && 
        (request.resource.data.userId == request.auth.uid || request.resource.data.ownerRef == request.auth.uid) &&
        matchesUserRegion(request.resource.data.region)
      );
      allow update: if isAdmin() || (
        isAuthenticated() && 
        (resource.data.userId == request.auth.uid || resource.data.ownerRef == request.auth.uid) &&
        matchesUserRegion(resource.data.region) &&
        (!('region' in request.resource.data) || request.resource.data.region == resource.data.region)
      );
      allow delete: if isAdmin() || (
        isAuthenticated() && 
        (resource.data.userId == request.auth.uid || resource.data.ownerRef == request.auth.uid)
      );
    }

    // Subscriptions: Users access their own, Admins have global access
    match /subscriptions/{subscriptionId} {
      allow read, write: if isAdmin() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid));
    }

    // financial_obligations
    match /financial_obligations/{obligationId} {
      allow read: if isAuthenticated() && (isAdmin() || (resource.data.userId == request.auth.uid) || (resource.data.ownerRef == request.auth.uid) || isOwner(resource.data.businessRef));
      allow create: if isAuthenticated() && (isAdmin() || (request.resource.data.userId == request.auth.uid) || (request.resource.data.ownerRef == request.auth.uid) || isOwner(request.resource.data.businessRef));
      allow update, delete: if isAuthenticated() && (isAdmin() || (resource.data.userId == request.auth.uid) || (resource.data.ownerRef == request.auth.uid) || isOwner(resource.data.businessRef));
    }

    // financial_health_snapshots
    match /financial_health_snapshots/{snapshotId} {
      allow read: if isAuthenticated() && (isAdmin() || (resource.data.userId == request.auth.uid) || (resource.data.ownerRef == request.auth.uid) || isOwner(resource.data.businessRef));
      allow create: if isAuthenticated() && (isAdmin() || (request.resource.data.userId == request.auth.uid) || (request.resource.data.ownerRef == request.auth.uid) || isOwner(request.resource.data.businessRef));
      allow update, delete: if isAuthenticated() && (isAdmin() || (resource.data.userId == request.auth.uid) || (resource.data.ownerRef == request.auth.uid) || isOwner(resource.data.businessRef));
    }

    // financial_alerts
    match /financial_alerts/{alertId} {
      allow read: if isAuthenticated() && (isAdmin() || (resource.data.userId == request.auth.uid) || (resource.data.ownerRef == request.auth.uid) || isOwner(resource.data.businessRef));
      allow create: if isAuthenticated() && (isAdmin() || (request.resource.data.userId == request.auth.uid) || (request.resource.data.ownerRef == request.auth.uid) || isOwner(request.resource.data.businessRef));
      allow update, delete: if isAuthenticated() && (isAdmin() || (resource.data.userId == request.auth.uid) || (resource.data.ownerRef == request.auth.uid) || isOwner(resource.data.businessRef));
    }

    // Learning Articles: Publicly readable; Only Admins can write/publish
    match /learning_articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Alerts & Broadcasts: Publicly readable; Only Admins can broadcast
    match /alerts/{alertId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Regional Configurations: Publicly readable; Only Admins can update
    match /regionalSettings/{regionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Config & Custom Domain: Publicly readable; Only Admins can write
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Test connection collection
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
