# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PRODUCTION DOMAIN
VITE_APP_DOMAIN="https://startbill.com"

# STRIPE LIVE (PRODUCTION)
# Clé secrète Stripe pour le traitement des paiements (serveur)
STRIPE_SECRET_KEY="sk_live_..."
# Clé publique Stripe pour les formulaires de checkout (client)
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_..."
# Secret de signature de webhook Stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# FIREBASE PRODUCTION (Optionnel si vous utilisez firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="startbill.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="startbill-prod"
VITE_FIREBASE_STORAGE_BUCKET="startbill-prod.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
